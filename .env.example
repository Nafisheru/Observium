# =============================================================================
# Observium Docker - Environment Configuration
# =============================================================================
# PENTING: Ganti semua nilai "changeme" sebelum deploy!
# =============================================================================

# -- Timezone --
TZ=Asia/Jakarta

# -- Port mapping (host:container) --
OBSERVIUM_PORT=8080

# -- Database --
MARIADB_ROOT_PASSWORD=changeme_root_password
DB_HOST=mariadb
DB_NAME=observium
DB_USER=observium
DB_PASSWORD=changeme_db_password

# -- Observium Admin --
OBSERVIUM_ADMIN_USER=admin
OBSERVIUM_ADMIN_PASSWORD=changeme_admin_password

# -- SNMP Default Community String --
OBSERVIUM_SNMP_COMMUNITY=public

# -- Database Connection Timeout (seconds) --
DB_CONNECTION_TIMEOUT=90
